# npm 10 (bundled with Node 22, which CI and the engines floor use) crashes
# in its peer-dependency resolver ("Cannot read properties of null (reading
# 'edgesOut')") on this dev tree ever since vitest 5 appeared on the registry:
# it walks the optional peers of vitest 4 into the 5.x line and loops. npm 11
# is not affected. Skipping automatic peer resolution sidesteps it; every peer
# this tree needs is a direct devDependency already. Not shipped: npm never
# packs .npmrc, so a Signal K App Store install is unaffected.
legacy-peer-deps=true
