{
  "name": "@marineyachtradar/signalk-plugin",
  "version": "1.5.1",
  "description": "MaYaRa Radar - Connect SignalK to mayara-server",
  "main": "plugin/index.js",
  "type": "module",
  "signalk-plugin-enabled-by-default": true,
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" && eslint --fix 'src/**/*.ts' 'src/**/*.tsx' 'test/**/*.ts' && npm run format:other",
    "format:other": "prettier --write \"**/*.md\" \"*.{json,yml,yaml,mjs,js}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\" \"test/**/*.ts\" \"**/*.md\" \"*.{json,yml,yaml,mjs,js}\" \".github/**/*.{yml,yaml}\"",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx' 'test/**/*.ts'",
    "build": "tsc && npm run typecheck:panel && node build.js && vite build",
    "build:config": "vite build",
    "typecheck:panel": "tsc -p src/configpanel --noEmit",
    "build:all": "npm run lint && npm run build && npm run test",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "test:e2e": "node test/e2e/run-e2e.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-instruments",
    "radar",
    "marine",
    "mayara",
    "signalk-plugin-configurator"
  ],
  "signalk": {
    "displayName": "MaYaRa Radar (Server)",
    "appIcon": "assets/mayara_logo.png",
    "webapp": {
      "name": "MaYaRa Radar",
      "description": "Marine radar display connected to mayara-server",
      "location": "/plugins/@marineyachtradar/signalk-plugin/"
    },
    "screenshots": [
      "./docs/screenshot/mayara_screenshot_1.png"
    ],
    "requires": [
      "signalk-container"
    ]
  },
  "files": [
    "plugin/**/*",
    "public/**/*",
    "docs/**/*"
  ],
  "engines": {
    "node": ">=22.15.0",
    "signalk": ">=2.31.0"
  },
  "dependencies": {
    "http-proxy-middleware": "^4.2.0",
    "signalk-container-helper": "^0.9.0",
    "typebox": "^1.3.11",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.20.5",
    "@signalk/server-api": "^2.31.0-beta.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarineYachtRadar/mayara-server-signalk-plugin"
  },
  "author": "MarineYachtRadar Contributors",
  "license": "Apache-2.0"
}
