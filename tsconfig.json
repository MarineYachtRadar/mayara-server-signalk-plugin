{
  "compilerOptions": {
    "target": "ES2022",

    // The package is "type": "module", so the emitted plugin/ must be real ESM.
    // nodenext resolution is what makes tsc enforce Node's actual ESM rules —
    // notably that relative imports carry the emitted `.js` extension. Under
    // "bundler" resolution tsc accepts extensionless specifiers and emits them
    // verbatim, which Node then rejects at load with ERR_MODULE_NOT_FOUND.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "lib": ["ES2022"],
    "outDir": "plugin",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  // src/configpanel is a browser bundle (JSX + DOM types) with its own
  // tsconfig; letting it in here would force those into the Node compile.
  "exclude": ["node_modules", "plugin", "test", "src/configpanel"]
}
